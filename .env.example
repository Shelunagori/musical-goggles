# musical-goggles AI Classroom — environment reference.
# Each app reads its own file: copy apps/api/.env.example -> apps/api/.env
# and apps/web/.env.example -> apps/web/.env.local. Never commit real values.

# ---------------- apps/api (server-side only; Render env vars in production) ----------------
# Supabase → Project Settings → Database → Connection string.
# Render free tier has no IPv6: use the *Session pooler* string (port 5432), not the direct db.<ref> host.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# auto (TLS for non-local hosts) | require | disable
DATABASE_SSL=auto
# Optional: Supabase CA certificate (PEM) to verify the server certificate.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Phase 2 — Deepgram streaming STT (server-side only).
DEEPGRAM_API_KEY=
# Phase 2 — local embedding model (384 dims, matches vector(384) in the schema).
EMBEDDING_MODEL=Xenova/multilingual-e5-small

# ---------------- apps/web (browser-visible! public values only) ----------------
NEXT_PUBLIC_API_URL=http://localhost:4000
