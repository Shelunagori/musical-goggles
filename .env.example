# musical-goggles AI Classroom — environment reference.
# Each app reads its own file: copy apps/api/.env.example -> apps/api/.env
# and apps/web/.env.example -> apps/web/.env.local. Never commit real values.

# ---------------- apps/api (server-side only; Render env vars in production) ----------------
# Supabase → Project Settings → Database → Connection string.
# Render free tier has no IPv6: use the *Session pooler* string (port 5432), not the direct db.<ref> host.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# auto (TLS for non-local hosts) | require | disable
DATABASE_SSL=auto
# Optional: Supabase CA certificate (PEM) to verify the server certificate.
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Phase 2 — Deepgram streaming STT (server-side only).
DEEPGRAM_API_KEY=
# Phase 2 — local embedding model (384 dims, matches vector(384) in the schema).
# Enable only after measuring memory on the target host. Model must already be cached.
EMBEDDING_ENABLED=false
SEARCH_DEBUG=false
# Set true explicitly for db:embed / embedding:measure to download E5.
EMBEDDING_ALLOW_DOWNLOAD=false

# ---------------- apps/web (browser-visible! public values only) ----------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# API only: optional single-operator demo admin credential (32–256 characters).
ADMIN_API_TOKEN=
# Render sets NODE_ENV=production and supplies PORT; CORS_ORIGINS must be explicit.
# Full deployment and optional TLS CA setup: docs/deployment.md
