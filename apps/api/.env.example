# Copy to apps/api/.env (git-ignored). See /.env.example for explanations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/goggles
DATABASE_SSL=auto
DATABASE_SSL_CA=
DATABASE_POOL_MAX=5
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
# Phase 2
DEEPGRAM_API_KEY=
# Enable only after measuring memory on the target host. Model must already be cached.
EMBEDDING_ENABLED=false
SEARCH_DEBUG=false
# Set true explicitly for db:embed / embedding:measure to download E5.
EMBEDDING_ALLOW_DOWNLOAD=false
# Only for apps/api tests that hit a real database (optional).
TEST_DATABASE_URL=
